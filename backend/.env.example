# Server listening port (used for local development; Vercel automatically manages ports in serverless)
PORT=5000

# MongoDB Connection String (Atlas recommended for production)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/campusclubs?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/campusclubs?retryWrites=true&w=majority

# Mandatory JWT secret key used for signing and verifying tokens (minimum 32 random characters recommended)
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters

# Deployed Frontend URL for CORS authorization
# Example: https://campusclubs-frontend.vercel.app
CLIENT_URL=https://campusclubs-frontend.vercel.app
